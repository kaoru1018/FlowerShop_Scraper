WebAutomation.LaunchChrome.LaunchChrome Url: $'''https://www.yahoo.co.jp''' WindowState: WebAutomation.BrowserWindowState.Normal ClearCache: False ClearCookies: False WaitForPageToLoadTimeout: 60 Timeout: 60 PiPUserDataFolderMode: WebAutomation.PiPUserDataFolderModeEnum.AutomaticProfile TargetDesktop: $'''{\"DisplayName\":\"ローカル コンピューター\",\"Route\":{\"ServerType\":\"Local\",\"ServerAddress\":\"\"},\"DesktopType\":\"local\"}''' BrowserInstance=> Browser
File.ReadTextFromFile.ReadTextAsList File: $'''C:\\Users\\薫\\Desktop\\FlowerShops.csv''' Encoding: File.TextFileEncoding.UTF8 Contents=> FileContents
Variables.RemoveDuplicateItemsFromList List: FileContents IgnoreCase: False
LOOP FOREACH CurrentItem IN FileContents
    IF Contains(CurrentItem, $'''http''', False) THEN
        WebAutomation.GoToWebPage.GoToWebPage BrowserInstance: Browser Url: CurrentItem WaitForPageToLoadTimeout: 60
        WebAutomation.GetDetailsOfWebPage BrowserInstance: Browser DetailsType: WebAutomation.DetailsType.Title Details=> WebPageTitle
        WebAutomation.GetDetailsOfWebPage BrowserInstance: Browser DetailsType: WebAutomation.DetailsType.Description Details=> ExtractedText
        Text.SplitText.SplitWithDelimiter Text: ExtractedText CustomDelimiter: $'''\\n''' IsRegEx: False Result=> TextList
        IF IsNotBlank(WebPageTitle) THEN
            File.WriteText File: $'''C:\\Users\\薫\\Desktop\\test.csv''' TextToWrite: $'''\"%WebPageTitle%\",\"%CurrentItem%\",,\"%TextList%[0]\"''' AppendNewLine: True IfFileExists: File.IfFileExists.Append Encoding: File.FileEncoding.UTF8
        END
    END
END
